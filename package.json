{
  "name": "CFWorkerACME",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "web-dev": "npm --prefix frontend run dev",
    "web-build": "npm --prefix frontend run build",
    "web-install": "npm --prefix frontend install",
    "dev-js": "tsx watch src/basic.ts",
    "build-js": "webpack --mode production",
    "deploy-js": "node dist/bundle.js",
    "providers:sync": "node scripts/sync-lego-dns-providers.mjs --write",
    "providers:sync:dry-run": "node scripts/sync-lego-dns-providers.mjs --dry-run",
    "providers:check": "node scripts/sync-lego-dns-providers.mjs --check",
    "providers:overlay": "node scripts/create-lego-doh-overlay.mjs",
    "providers:build": "node scripts/build-lego-shards.mjs",
    "providers:build:all": "node scripts/build-lego-shards.mjs --all",
    "providers:gates": "node scripts/build-lego-shards.mjs --gates-only",
    "providers:test": "node --test tests/lego-provider-sync.test.mjs tests/lego-provider-runtime.test.mjs",
    "providers:update": "npm run providers:sync && npm run providers:build:all && npm run providers:test && npm run providers:gates && npm run providers:check",
    "providers:deploy:plan": "node scripts/deploy-lego-shards.mjs --plan",
    "providers:deploy": "node scripts/deploy-lego-shards.mjs --apply",
    "dev-cf": "npm run patch:acme && wrangler dev",
    "dev-cf:test": "npm run patch:acme && wrangler dev -c ./wrangler.encrypt.jsonc",
    "deploy-cf": "npm run patch:acme && npm run build && npm run providers:deploy",
    "deploy-cf:test": "npm run patch:acme && npm run build && wrangler deploy --minify -c ./wrangler.encrypt.jsonc",
    "dev-eo": "edgeone pages dev",
    "build-eo": "edgeone pages build",
    "deploy-eo": "edgeone pages deploy ./ -n workacme-web -t ",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "patch:acme": "patch-package",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@edgeone/ef-types": "^1.0.5",
    "@hono/node-server": "^1.16.0",
    "acme-client": "^5.4.0",
    "axios": "^1.9.0",
    "clawer-software": "file:../../windows/Clawer_Software",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.0.1",
    "edgeone": "^1.1.18",
    "hono": "^4.7.7",
    "ipaddr.js": "^2.5.0",
    "jszip": "^3.10.1",
    "node-forge": "^1.3.1",
    "resend": "^4.4.1",
    "ssh2": "^1.17.0",
    "xior": "^0.7.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@serverless-devs/s": "^3.1.10",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.14.1",
    "@types/node-forge": "^1.3.11",
    "@types/ssh2": "^1.15.6",
    "esbuild": "^0.25.5",
    "patch-package": "^8.0.1",
    "playwright-core": "^1.64.1",
    "ts-loader": "^9.5.1",
    "tsx": "^4.7.1",
    "toml": "^3.0.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "wrangler": "^4.3.0"
  },
  "overrides": {}
}
